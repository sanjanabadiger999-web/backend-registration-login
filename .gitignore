# ---- Backend (Maven) ----
target/

# ---- Frontend (Vite) ----
node_modules/
dist/

# ---- Environment files - NEVER commit real secrets ----
.env
.env.local
.env.production
.env.*.local
!.env.example

# ---- Frontend lives in its own repository (frontend-registration-login).
#      Kept locally, but not tracked in this backend repo. ----
/Frontend/
/FrontendRegLogin/

# ---- TLS / credential files (Aiven CA cert, keys, secrets) ----
*.pem
*.crt
*.key
*.p12
!**/pki/*.pem

# ---- IDE / OS / runtime ----
.idea/
.vscode/
*.iml
.DS_Store
*.log
hs_err_pid*
logs/

# Render blueprint may contain placeholder values only
# (do not put real DB passwords or JWT secrets in this file).