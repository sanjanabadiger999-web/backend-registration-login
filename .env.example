# ============================================================
# Backend production environment - copy to `.env` if you want a
# local "production-style" run. NEVER commit real values.
# ============================================================

# ---- Aiven MySQL (from Aiven console -> service -> Connection information) ----
# EITHER give the full JDBC URL:
# Format: jdbc:mysql://HOST:PORT/DB_NAME?ssl-mode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://<HOST>:<PORT>/<DB_NAME>?ssl-mode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=avnadmin
DB_PASSWORD=

# OR build it from the per-field values (Aiven "Connection information" fields:
# Host, Port, Database name, plus your password). Only used when DB_URL is empty.
# DB_HOST=reglogin-db-abcd.aivencloud.com
# DB_PORT=16167
# DB_NAME=reglogin-db
# DB_SSL=true        # ssl-mode=REQUIRED when true (Aiven requires TLS)
# DB_USERNAME=avnadmin
# DB_PASSWORD=

# ---- JWT (Base64-encoded 256-bit HS256 secret) ----
# Generate with:  openssl rand -base64 32
JWT_SECRET=

# ---- Server ----
PORT=8080

# ---- CORS: your deployed frontend origin (Vercel) ----
FRONTEND_URL=https://<your-app>.vercel.app
# Optional: comma-separated override (wins over FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# ---- Optional cookie overrides ----
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAME_SITE=None
# JWT_EXPIRY_MINUTES=30